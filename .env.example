# RustChain Configuration
# Copy this file to .env and fill in your values.

# Network
RTC_NETWORK=mainnet
RTC_RPC_URL=https://rpc.rustchain.io
RTC_P2P_PORT=8333

# Node
RTC_DATA_DIR=./data
RTC_LOG_LEVEL=info
RTC_LOG_FILE=./logs/rtc.log

# Mining (optional - only needed if you run a miner)
# RTC_MINER_ENABLED=false
# RTC_MINER_THREADS=4
# RTC_MINER_ALGORITHM=ppa

# PPA (Proof of Antiquity)
RTC_PPA_FINGERPRINT_PATH=./fingerprint.json
RTC_PPA_MIN_AGE_YEARS=10

# Security
RTC_API_KEY=
RTC_API_SECRET=
RTC_TLS_CERT_PATH=
RTC_TLS_KEY_PATH=

# Windows-specific (uncomment on Windows)
# RTC_DATA_DIR=%USERPROFILE%\.rustchain\data
# RTC_LOG_FILE=%USERPROFILE%\.rustchain\logs\rtc.log
