# RustChain Miner Configuration
# Copy this file to .env.miner and fill in your values.

# Miner
RTC_MINER_ENABLED=true
RTC_MINER_THREADS=4
RTC_MINER_ALGORITHM=ppa
RTC_MINER_WORKER_ID=

# Hardware Fingerprinting
RTC_PPA_FINGERPRINT_PATH=./fingerprint.json
RTC_PPA_OSCILLATOR_DRIFT=true
RTC_PPA_CACHE_TIMING=true
RTC_PPA_SIMD_IDENTITY=true
RTC_PPA_THERMAL_ENTROPY=true
RTC_PPA_INSTRUCTION_JITTER=true

# Network
RTC_RPC_URL=https://rpc.rustchain.io
RTC_P2P_PORT=8333

# Windows-specific (uncomment on Windows)
# RTC_PPA_FINGERPRINT_PATH=%USERPROFILE%\.rustchain\fingerprint.json
# RTC_MINER_WORKER_ID=auto
